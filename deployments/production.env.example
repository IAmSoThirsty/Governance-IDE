# Production deployment contract.
# Do not copy this file to .env with real secrets. Inject values through your
# orchestrator, CI secret store, or host secret manager.

SOVEREIGN_SIGNING_KEY=REPLACE_WITH_PRODUCTION_SECRET_FROM_SECRET_MANAGER
SOVEREIGN_SERVICE_TOKEN=REPLACE_WITH_PRODUCTION_BEARER_TOKEN_FROM_SECRET_MANAGER
SOVEREIGN_POLICY_PATH=policies/baseline_policy.json
SOVEREIGN_STATE_DIR=/app/state

# Release/image identity. Must be a durable registry image, not a local tag.
SOVEREIGN_IMAGE_REF=registry.example.com/sovereign/sovereign-ide-runtime:0.1.0

# Durable runtime state. The container path is /app/state; this URI names the
# backing storage in the deployment environment.
SOVEREIGN_STATE_BACKEND=persistent_volume
SOVEREIGN_STATE_URI=pvc://sovereign-ide-state

# Real fine-tuning execution. This command receives --request and --output.
SOVEREIGN_TRAINING_COMMAND=python scripts/trainers/trl_sft_trainer.py
SOVEREIGN_TRAINING_ARTIFACT_STORE=s3://replace-with-model-artifact-bucket/checkpoints

# Release governance.
SOVEREIGN_RELEASE_APPROVERS=release_authority,security_reviewer
