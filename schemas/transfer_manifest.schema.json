{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-ide.local/schemas/transfer_manifest.schema.json",
  "title": "AirgapTransferManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "bundleId",
    "sourceDomain",
    "targetDomain",
    "createdAt",
    "classification",
    "items",
    "signatures",
    "approval"
  ],
  "properties": {
    "manifestVersion": { "type": "string", "const": "1.0.0" },
    "bundleId": { "type": "string", "minLength": 1 },
    "sourceDomain": { "type": "string", "minLength": 1 },
    "targetDomain": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "classification": {
      "type": "string",
      "enum": ["internal", "confidential", "secret", "sovereign"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "artifactType",
          "checksum",
          "provenanceRef",
          "promotionTier"
        ],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "artifactType": { "type": "string", "minLength": 1 },
          "checksum": {
            "type": "string",
            "pattern": "^sha256:[a-fA-F0-9]{64}$"
          },
          "provenanceRef": { "type": "string", "minLength": 1 },
          "promotionTier": { "type": "string", "minLength": 1 }
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signer", "algorithm", "signature"],
        "properties": {
          "signer": { "type": "string", "minLength": 1 },
          "algorithm": {
            "type": "string",
            "enum": ["ed25519", "rsa-pss-sha256", "ecdsa-p256-sha256", "hmac-sha256"]
          },
          "signature": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedBy", "decisionRecordId"],
      "properties": {
        "approvedBy": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "decisionRecordId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
