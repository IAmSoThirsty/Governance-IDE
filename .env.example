# Copy this file to .env for local/dev use.
# For production, inject secrets via secure secret management.

SOVEREIGN_SIGNING_KEY=REPLACE_WITH_64_BYTE_HEX_OR_HIGH_ENTROPY_SECRET
SOVEREIGN_SERVICE_TOKEN=REPLACE_WITH_LOCAL_SERVICE_TOKEN
SOVEREIGN_POLICY_PATH=policies/baseline_policy.json
SOVEREIGN_STATE_DIR=state
SOVEREIGN_JOURNAL_BACKEND=sqlite
SOVEREIGN_RUNTIME_MODE=local
SOVEREIGN_SIGNER_BACKEND=hmac-dev

# Optional signer metadata.
# SOVEREIGN_SIGNER_KEY_ID=local-dev-key

# Ed25519 signer material for non-local runtime modes.
# Provide either *_PATH or *_PEM when SOVEREIGN_SIGNER_BACKEND=ed25519.
# SOVEREIGN_ED25519_PRIVATE_KEY_PATH=state/keys/ed25519_private_key.pem
# SOVEREIGN_ED25519_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----
